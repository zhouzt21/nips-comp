__pycache__/
*.py[cod]

# Large local outputs from retrieval and research stay outside version control.
/emb_cache/

# Local secrets and environment configuration
.env
.env.*
!.env.example

# Generated data, archives, environments, and local predictor configuration.
/payload
/dist/
.venv/
.ruff_cache/
*.zip
*.log
blf_runs/
submission_config.json
models.txt
/mlp/weights.npz
/mlp/weights.json

# Archived local development artifacts and compatibility paths.
/paec_competition_submission/

# Keep reproducibility records at their original paths. Large CSVs, fitted
# arrays and generated binary artifacts remain ignored. These exceptions also
# preserve historical code snapshots and execution logs used by the reports.
/runs/**
!/runs/**/
!/runs/**/*.json
!/runs/**/*.jsonl
!/runs/**/*.md
!/runs/**/*.py
!/runs/**/*.txt
!/runs/**/*.log
